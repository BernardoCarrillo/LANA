    { "name": "Registrar ingreso", "short_name": "Ingreso", "url": "./#/inicio?quick=income", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Registrar pago de tarjeta", "short_name": "Pago TC", "url": "./#/cuentas?pay=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
